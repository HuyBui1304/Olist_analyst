	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Quarter", "Month", "YearMonth", "Weekday"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"MonthNo", Int64.Type}, {"Month", type text}, {"YearMonth", type text}, {"YearMonthKey", Int64.Type}, {"MonthStart", type date}, {"Weekday", type text}, {"WeekdayNo", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

