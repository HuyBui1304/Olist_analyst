	partition Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"customer_unique_id", "order_count_group", "customer_type"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"customer_unique_id", type text}, {"first_order_date", type date}, {"n_orders", Int64.Type}, {"lifetime_value", type number}, {"order_count_group", type text}, {"order_count_sort", Int64.Type}, {"customer_type", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

