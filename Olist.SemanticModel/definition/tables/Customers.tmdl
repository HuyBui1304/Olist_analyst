		formatString: dd/MM/yyyy
		lineageTag: 9f903693-7d33-50f7-acc5-5bea0a25cbf8
		summarizeBy: none
		sourceColumn: first_order_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column n_orders
		dataType: int64
		formatString: 0
		lineageTag: c77a9d83-6a14-5f70-afe2-63c67ca89bbe
		summarizeBy: none
		sourceColumn: n_orders

		annotation SummarizationSetBy = Automatic

	column lifetime_value
		dataType: double
		formatString: #,0.00
		lineageTag: 5b171aef-832e-5785-b8eb-e6c733c05a6d
		summarizeBy: none
		sourceColumn: lifetime_value

