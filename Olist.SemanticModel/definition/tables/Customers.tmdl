table Customers
	lineageTag: 4fc166fd-430d-5a3e-886e-7de9ddc41c5f

	column customer_unique_id
		dataType: string
		isHidden
		lineageTag: e9f0bf62-7766-5e1f-b74f-6db8ba735bd8
		summarizeBy: none
		sourceColumn: customer_unique_id

		annotation SummarizationSetBy = Automatic

	column first_order_date
