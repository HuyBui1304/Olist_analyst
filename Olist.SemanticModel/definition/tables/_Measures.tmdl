			VAR _from = EDATE(MINX(_cur, [Date]), -12)
			VAR _to = EDATE(MAXX(_cur, [Date]), -12)
			VAR _c = CALCULATE([Installment Order Rate], _cur)
			VAR _p = CALCULATE([Installment Order Rate], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], _from, _to))
			RETURN IF(NOT ISBLANK(_c) && NOT ISBLANK(_p), _c - _p)
		formatString: 0.0%
		displayFolder: 7. Payments\YoY
		lineageTag: 7c1e3bb8-660e-54f6-a99c-884e6c6776c7

