table _Measures
	lineageTag: 0258437f-0ec3-51eb-9353-9d5493fe6aad

	measure 'Total Orders' = COUNTROWS(Orders)
		formatString: #,0
		displayFolder: 1. Overview
		lineageTag: b0682c34-cd32-5329-86a4-c04965eabb69

	measure 'Delivered Orders' = CALCULATE(COUNTROWS(Orders), Orders[is_delivered] = 1)
		formatString: #,0
		displayFolder: 1. Overview
		lineageTag: 8a730261-4dd6-5952-adf7-e0b0ef7e2821

	measure 'Delivered Sales' = CALCULATE(SUM(Orders[order_value]), Orders[is_delivered] = 1)
		formatString: R$ #,0
		displayFolder: 1. Overview
		lineageTag: a46b5ae1-123c-558f-ae8d-5f87d8017264

	measure 'Avg Order Value' = DIVIDE([Delivered Sales], [Delivered Orders])
		formatString: R$ #,0.00
		displayFolder: 1. Overview
		lineageTag: 36aa9d8d-d53c-5a34-9827-36d06f8259ee

	measure 'Canceled Orders' = CALCULATE(COUNTROWS(Orders), Orders[is_canceled] = 1)
		formatString: #,0
		displayFolder: 1. Overview
		lineageTag: fa948947-136e-570c-a8ed-acdeeb08640d

	measure 'Cancellation Rate' = DIVIDE([Canceled Orders], [Total Orders])
		formatString: 0.00%
		displayFolder: 1. Overview
		lineageTag: ebb586e9-9187-5edc-8ecd-e3536ecf6ff8

	measure 'Undelivered Orders' = CALCULATE(COUNTROWS(Orders), Orders[is_delivered] = 0)
		formatString: #,0
		displayFolder: 1. Overview
		lineageTag: 5e3e47b4-78db-5a49-917c-6a41a34122c4

	measure 'Orders Canceled' = CALCULATE(COUNTROWS(Orders), Orders[order_status] = "canceled")
		formatString: #,0
		displayFolder: 1. Overview
		lineageTag: 6310cfee-0905-5d25-a6b3-005680c2ab54

	measure 'Orders Unavailable' = CALCULATE(COUNTROWS(Orders), Orders[order_status] = "unavailable")
		formatString: #,0
		displayFolder: 1. Overview
		lineageTag: c41cfb6d-e080-513a-b6ab-8b37f1345de6

	measure 'Orders In Progress' = CALCULATE(COUNTROWS(Orders), Orders[status_sort] = 4)
		formatString: #,0
		displayFolder: 1. Overview
		lineageTag: 7b650666-c774-58a5-ad87-df117b8862bf

	measure 'Sales Share (State)' = DIVIDE([Delivered Sales], CALCULATE([Delivered Sales], REMOVEFILTERS(States)))
		formatString: 0.0%
		displayFolder: 1. Overview
		lineageTag: af10d73e-ab07-5f30-b499-5188736adb8c

	measure 'Avg Delivery Days' = AVERAGE(Orders[delivery_days])
		formatString: #,0.0
		displayFolder: 2. Delivery
		lineageTag: ef225239-c1a9-545c-a59f-de4388eda27e

	measure 'Avg Estimated Days' = CALCULATE(AVERAGE(Orders[estimated_days]), Orders[is_delivered] = 1)
		formatString: #,0.0
		displayFolder: 2. Delivery
		lineageTag: 3f1628c1-b554-5c03-a757-fd1c5a2a3635

	measure 'Late Delivery Rate' = AVERAGE(Orders[is_late])
		formatString: 0.0%
		displayFolder: 2. Delivery
		lineageTag: b1c1ee6b-c3f2-5b3e-ab7e-655b6a6a3ae0

	measure 'On-Time Delivery Rate' = IF(NOT ISBLANK([Late Delivery Rate]), 1 - [Late Delivery Rate])
		formatString: 0.0%
		displayFolder: 2. Delivery
		lineageTag: 64a284a0-885a-57ff-87cd-bcbab898cbb5

	measure 'Late Orders' = CALCULATE(COUNTROWS(Orders), Orders[is_late] = 1)
		formatString: #,0
		displayFolder: 2. Delivery
		lineageTag: 9ebc594a-d704-5f8d-9dfc-8dc1ffd89f07

	measure 'Avg Days Late' = CALCULATE(AVERAGE(Orders[delay_days]), Orders[is_late] = 1)
		formatString: #,0.0
		displayFolder: 2. Delivery
		lineageTag: 6ea0ba8c-dc54-5d1b-ad4c-c6ffe45c48f1

	measure 'Avg Days Ahead of ETA' = -AVERAGE(Orders[delay_days])
		formatString: #,0.0
		displayFolder: 2. Delivery
		lineageTag: de1e1dff-32a1-5df8-879d-3be3c476ba2e

	measure 'Avg Approval Days' = CALCULATE(AVERAGE(Orders[approval_hours]) / 24, Orders[is_delivered] = 1)
		formatString: #,0.0
		displayFolder: 2. Delivery
		lineageTag: e560beeb-8a2a-5aed-ab77-cc5bbce35303

	measure 'Avg Seller Handling Days' = CALCULATE(AVERAGE(Orders[handling_days]), Orders[is_delivered] = 1)
		formatString: #,0.0
		displayFolder: 2. Delivery
		lineageTag: 56a31790-2633-531a-80a5-a6ea0b88f05b

	measure 'Avg Carrier Transit Days' = AVERAGE(Orders[transit_days])
		formatString: #,0.0
		displayFolder: 2. Delivery
		lineageTag: 0aabc099-b3e6-5ad7-aa88-b199d57a6144

	measure 'Freight-to-Value Ratio' = DIVIDE(CALCULATE(SUM(Orders[freight_value]), Orders[is_delivered] = 1), CALCULATE(SUM(Orders[items_value]), Orders[is_delivered] = 1))
		formatString: 0.0%
		displayFolder: 2. Delivery
		lineageTag: 619e9ca8-4ac8-575d-9e35-4c55f80e29ae

	measure 'Order Share (Delivery Time)' =
			VAR n = COUNT(Orders[delivery_days])
			RETURN IF(n > 0, DIVIDE(n, CALCULATE(COUNT(Orders[delivery_days]), REMOVEFILTERS(Orders[delivery_bucket], Orders[delivery_bucket_sort]))))
		formatString: 0.0%
		displayFolder: 2. Delivery
		lineageTag: db82cdea-3240-5363-9285-78a414dbe0a0

	measure 'Late Rate Color' = VAR r = [Late Delivery Rate] RETURN SWITCH(TRUE(), r >= 0.12, "#F26F6F", r >= 0.08, "#F7B531", "#C2FA5C")
		displayFolder: 2. Delivery
		lineageTag: 3df2d512-f7a1-5a36-aa85-ced781f90f33

	measure 'Avg Review Score' = AVERAGE(Orders[review_score])
		formatString: 0.00
		displayFolder: 3. Customer Experience
		lineageTag: 1c57a215-50e8-5d0e-868c-7e6a8e478299

	measure Reviews = COUNT(Orders[review_score])
		formatString: #,0
		displayFolder: 3. Customer Experience
		lineageTag: e9937730-4672-5c30-a59f-fb05c08a5225

	measure '5-Star Rate' = DIVIDE(CALCULATE([Reviews], Orders[review_score] = 5), [Reviews])
		formatString: 0.0%
		displayFolder: 3. Customer Experience
		lineageTag: fba182f5-6411-5c53-8df0-0ebc1d588943

	measure 'Negative Review Rate' = DIVIDE(CALCULATE([Reviews], Orders[review_score] <= 2), [Reviews])
		formatString: 0.0%
		displayFolder: 3. Customer Experience
		lineageTag: 87b47dec-a1fc-509f-9a7f-f04ce8feb378

	measure 'Comment Rate' = DIVIDE(CALCULATE([Reviews], Orders[has_review_comment] = 1), [Reviews])
		formatString: 0.0%
		displayFolder: 3. Customer Experience
		lineageTag: 9c965ef1-1d68-5c21-8dfa-7b630ea42274

	measure 'Avg Score (Late Orders)' = CALCULATE([Avg Review Score], Orders[is_late] = 1)
		formatString: 0.00
		displayFolder: 3. Customer Experience
		lineageTag: 84927425-26ca-5ec3-b10d-e1197c0a1a3d

	measure 'Avg Score (On-Time Orders)' = CALCULATE([Avg Review Score], Orders[is_late] = 0)
		formatString: 0.00
		displayFolder: 3. Customer Experience
		lineageTag: 7bd8d0e4-54e9-51ef-bfdf-db445501fd9d

	measure 'Review Share' = IF([Reviews] > 0, DIVIDE([Reviews], CALCULATE([Reviews], REMOVEFILTERS(Orders[review_label], Orders[review_score]))))
		formatString: 0.0%
		displayFolder: 3. Customer Experience
		lineageTag: fe568778-f2d5-5d56-9523-7d9587f1ce45

	measure 'Avg Score (100+ Reviews)' = IF([Reviews] >= 100, [Avg Review Score])
		formatString: 0.00
		displayFolder: 3. Customer Experience
		lineageTag: 20f6636f-08f2-5645-a7b2-dcf49c4c8c4c

	measure 'Score Color' = VAR s = [Avg Review Score] RETURN SWITCH(TRUE(), ISBLANK(s), "#8C8C8C", s < 3, "#F26F6F", s < 4, "#F7B531", "#C2FA5C")
		displayFolder: 3. Customer Experience
		lineageTag: 9cdd0a21-90fb-5259-a581-1c623d479f01

	measure 'Star Color' = VAR s = SELECTEDVALUE(Orders[review_score]) RETURN SWITCH(TRUE(), s <= 2, "#F26F6F", s = 3, "#F7B531", "#C2FA5C")
		displayFolder: 3. Customer Experience
		lineageTag: 61c0f001-d4d1-57a5-b45d-71af6872de4d

	measure 'Item Sales' = CALCULATE(SUM(OrderItems[item_value]), Orders[is_delivered] = 1)
		formatString: R$ #,0
		displayFolder: 4. Sellers
		lineageTag: a77f3e70-ba28-5b44-b7de-e95d19c8750e

	measure 'Active Sellers' = DISTINCTCOUNT(OrderItems[seller_id])
		formatString: #,0
		displayFolder: 4. Sellers
		lineageTag: d0f26026-3cf9-510d-91c5-9ca61538d8d7

	measure 'New Sellers' =
			VAR _min = MIN('Date'[Date]) VAR _max = MAX('Date'[Date])
			RETURN CALCULATE([Active Sellers], KEEPFILTERS(FILTER(ALL(Sellers[first_sale_date]),
			    Sellers[first_sale_date] >= _min && Sellers[first_sale_date] <= _max)))
		formatString: #,0
		displayFolder: 4. Sellers
		lineageTag: df3898ed-51d9-5a6b-91bc-bd6815452e14

	measure 'Sales per Seller' = DIVIDE([Item Sales], [Active Sellers])
		formatString: R$ #,0
		displayFolder: 4. Sellers
		lineageTag: e33af54e-01b0-56ee-a91d-87e45deb22b4

	measure 'Top 10% Seller Share' =
			VAR _s = ADDCOLUMNS(VALUES(OrderItems[seller_id]), "@rev", [Item Sales])
			VAR _k = ROUNDUP(COUNTROWS(_s) * 0.1, 0)
			RETURN DIVIDE(SUMX(TOPN(_k, _s, [@rev], DESC), [@rev]), SUMX(_s, [@rev]))
		formatString: 0.0%
		displayFolder: 4. Sellers
		lineageTag: 388e8fca-da30-5ca3-881c-4b52465607ac

	measure 'Avg Seller Prep Days' = AVERAGE(Orders[handling_days])
		formatString: #,0.0
		displayFolder: 4. Sellers
		lineageTag: cacedcb8-bc2d-5410-aa52-0c7b3715cde5

	measure 'Late Handover Rate' = AVERAGE(OrderItems[seller_ship_late])
		formatString: 0.0%
		displayFolder: 4. Sellers
		lineageTag: 0b528a47-aa8d-5fa0-8048-6032679e767f

	measure 'Sales Share (Seller)' = DIVIDE([Item Sales], CALCULATE([Item Sales], REMOVEFILTERS(Sellers)))
		formatString: 0.0%
		displayFolder: 4. Sellers
		lineageTag: 3ad3f007-22d6-5703-9a3b-0d7f9af99f89

	measure 'Seller Count' = DISTINCTCOUNT(Sellers[seller_id])
		formatString: #,0
		displayFolder: 4. Sellers
		lineageTag: 72f421b8-375c-5215-bacd-3473edfc4517

	measure 'Items Sold' = CALCULATE(COUNTROWS(OrderItems), Orders[is_delivered] = 1)
		formatString: #,0
		displayFolder: 5. Products
		lineageTag: b2f55705-9db8-5cdd-abdd-8ad116572eef

	measure 'Categories Sold' = COUNTROWS(SUMMARIZE(CALCULATETABLE(OrderItems, Orders[is_delivered] = 1), Products[category]))
		formatString: #,0
		displayFolder: 5. Products
		lineageTag: 1e6af05a-b8b6-5a18-b15e-64abb9ca4539

	measure 'Products Sold' = CALCULATE(DISTINCTCOUNT(OrderItems[product_id]), Orders[is_delivered] = 1)
		formatString: #,0
		displayFolder: 5. Products
		lineageTag: 9bcedecf-94a1-5dcb-bdba-7743579df354

	measure 'Avg Item Price' = CALCULATE(AVERAGE(OrderItems[price]), Orders[is_delivered] = 1)
		formatString: R$ #,0.00
		displayFolder: 5. Products
		lineageTag: e3560d5d-2985-5624-ac6d-92e1266ac467

	measure 'Freight-to-Price Ratio' = DIVIDE(CALCULATE(SUM(OrderItems[freight_value]), Orders[is_delivered] = 1), CALCULATE(SUM(OrderItems[price]), Orders[is_delivered] = 1))
		formatString: 0.0%
		displayFolder: 5. Products
		lineageTag: 44ab9cff-f2a4-5016-9bd2-1974981e1d91

	measure 'Sales Share (Category)' = DIVIDE([Item Sales], CALCULATE([Item Sales], REMOVEFILTERS(Products)))
		formatString: 0.0%
		displayFolder: 5. Products
		lineageTag: 0e907d62-606c-5dcd-b57d-f660811b3cec

	measure 'Total Customers' = DISTINCTCOUNT(Orders[customer_unique_id])
		formatString: #,0
		displayFolder: 6. Customers
		lineageTag: a33b536d-f988-5a84-b636-5a2d34bd7e44

	measure 'New Customers' = CALCULATE([Total Customers], Orders[is_first_order] = 1)
		formatString: #,0
		displayFolder: 6. Customers
		lineageTag: a1b0316d-a93e-59c2-9d23-cd2c830e2ea9

	measure 'Returning Customers' = CALCULATE([Total Customers], Orders[customer_order_seq] > 1)
		formatString: #,0
		displayFolder: 6. Customers
		lineageTag: 78d466d3-7a82-5f77-aca3-d07eaab128e6

	measure 'Returning Customer Rate' = DIVIDE([Returning Customers], [Total Customers])
		formatString: 0.00%
		displayFolder: 6. Customers
		lineageTag: d50a1e61-286f-51fa-83a6-99f33e3695b3

	measure 'Orders per Customer' = DIVIDE([Total Orders], [Total Customers])
		formatString: 0.000
		displayFolder: 6. Customers
		lineageTag: 2bb3f678-6637-562e-827c-4e4e80b89c89

	measure 'Sales per Customer' = DIVIDE([Delivered Sales], [Total Customers])
		formatString: R$ #,0.00
		displayFolder: 6. Customers
		lineageTag: 4868707e-040d-5ac8-9370-2f853bc5ef66

	measure 'Customer Share' = DIVIDE([Total Customers], CALCULATE([Total Customers], REMOVEFILTERS(Customers[order_count_group], Customers[order_count_sort])))
		formatString: 0.00%
		displayFolder: 6. Customers
		lineageTag: 8e75c764-42ff-5001-95e2-ada8aae406fa

	measure 'Payment Value' = SUM(Payments[payment_value])
		formatString: R$ #,0
		displayFolder: 7. Payments
		lineageTag: b093c191-e127-511e-b55d-58f840524343

	measure 'Payment Transactions' = COUNTROWS(Payments)
		formatString: #,0
		displayFolder: 7. Payments
		lineageTag: 6c4da5c7-2203-5250-9bc8-98ca28de9de9

	measure 'Payment Value Share' = DIVIDE([Payment Value], CALCULATE([Payment Value], REMOVEFILTERS(Payments[payment_type])))
		formatString: 0.0%
		displayFolder: 7. Payments
		lineageTag: 98a5ad25-3098-5b23-8062-56f437ad136c

	measure 'Credit Card Share' = DIVIDE(CALCULATE([Payment Value], Payments[payment_type] = "Credit card"), [Payment Value])
		formatString: 0.0%
		displayFolder: 7. Payments
		lineageTag: 72474f18-728f-5d4b-b305-7d35dfcbb88e

	measure 'Avg Installments' = CALCULATE(AVERAGE(Payments[payment_installments]), Payments[payment_type] = "Credit card")
		formatString: #,0.0
		displayFolder: 7. Payments
		lineageTag: 59c1cf42-3334-582e-a1b8-fc3535d88786

	measure 'Installment Order Rate' = DIVIDE(CALCULATE([Total Orders], Orders[installments] > 1), [Total Orders])
		formatString: 0.0%
		displayFolder: 7. Payments
		lineageTag: 0b9c8968-b9a0-5efa-9a98-68c69f10d61b

	measure 'Voucher Order Rate' = DIVIDE(CALCULATE([Total Orders], Orders[uses_voucher] = 1), [Total Orders])
		formatString: 0.0%
		displayFolder: 7. Payments
		lineageTag: 335362b5-0641-5cf9-b49c-55ef9f4eab1b

	measure 'Credit Card Orders' = CALCULATE(DISTINCTCOUNT(Payments[order_id]), Payments[payment_type] = "Credit card")
		formatString: #,0
		displayFolder: 7. Payments
		lineageTag: d07f092a-bf40-542e-9257-ba4dbb02ad74

	measure 'Order Share (Installments)' = DIVIDE([Total Orders], CALCULATE([Total Orders], REMOVEFILTERS(Orders[installment_bucket], Orders[installment_sort])))
		formatString: 0.0%
		displayFolder: 7. Payments
		lineageTag: be374788-bb27-5f4c-a3ed-6d336d433369

	measure 'Total Orders Δ' =
			VAR _y = MAX('Date'[Year])
			VAR _cur = CALCULATETABLE(VALUES('Date'[Date]), KEEPFILTERS('Date'[Year] = _y))
			VAR _from = EDATE(MINX(_cur, [Date]), -12)
			VAR _to = EDATE(MAXX(_cur, [Date]), -12)
			VAR _c = CALCULATE([Total Orders], _cur)
			VAR _p = CALCULATE([Total Orders], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], _from, _to))
			RETURN IF(NOT ISBLANK(_c) && NOT ISBLANK(_p), DIVIDE(_c - _p, _p))
		formatString: 0.0%
		displayFolder: 1. Overview\YoY
		lineageTag: a4815af4-483e-5f0e-b5a5-08b55fb50dc5

	measure 'Total Orders Δ text' =
			VAR d = ROUND([Total Orders Δ], 3)
			VAR _y = MAX('Date'[Year])
			RETURN IF(ISBLANK(d), "No prior-year data for this period",
			    IF(d > 0, "▲ ", IF(d < 0, "▼ ", "■ ")) & FORMAT(ABS(d), "0.0%") & " vs same period " & (_y - 1))
		displayFolder: 1. Overview\YoY
		lineageTag: edd1ef37-b6ba-5ce3-9b67-71917a15b0e2

	measure 'Total Orders Δ color' =
			VAR d = ROUND([Total Orders Δ], 3)
			RETURN SWITCH(TRUE(), ISBLANK(d) || d = 0, "#8C8C8C", d > 0, "#C2FA5C", "#F26F6F")
		displayFolder: 1. Overview\YoY
		lineageTag: 3e5410f4-5eb9-5d05-9662-9f8448f28c2e

	measure 'Delivered Orders Δ' =
			VAR _y = MAX('Date'[Year])
			VAR _cur = CALCULATETABLE(VALUES('Date'[Date]), KEEPFILTERS('Date'[Year] = _y))
			VAR _from = EDATE(MINX(_cur, [Date]), -12)
			VAR _to = EDATE(MAXX(_cur, [Date]), -12)
			VAR _c = CALCULATE([Delivered Orders], _cur)
			VAR _p = CALCULATE([Delivered Orders], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], _from, _to))
			RETURN IF(NOT ISBLANK(_c) && NOT ISBLANK(_p), DIVIDE(_c - _p, _p))
		formatString: 0.0%
		displayFolder: 1. Overview\YoY
		lineageTag: 1374a640-8503-588e-961b-1b7a081cc86c

	measure 'Delivered Orders Δ text' =
			VAR d = ROUND([Delivered Orders Δ], 3)
			VAR _y = MAX('Date'[Year])
			RETURN IF(ISBLANK(d), "No prior-year data for this period",
