model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","_Measures","Orders","OrderItems","Payments","Products","Sellers","Customers","States","Date"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table Orders
ref table OrderItems
ref table Payments
ref table Products
ref table Sellers
ref table Customers
ref table States
ref table Date

ref cultureInfo en-US

